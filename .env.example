# App URL (production: https://sendflier.tech)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret

# HMAC for open/click/unsubscribe links (defaults to NEXTAUTH_SECRET if unset)
TRACKING_TOKEN_SECRET=

# Protects manual worker endpoints. The Heroku clock dyno runs in-process.
CRON_SECRET=

# Added automatically by the Heroku Postgres add-on.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flier
# Keep the pool small enough for the selected Heroku Postgres plan.
DATABASE_POOL_SIZE=5
# Clock polling interval. Defaults to one minute; minimum is 15 seconds.
SCHEDULED_CLOCK_INTERVAL_MS=60000

# AES-256 key encrypting stored Google refresh tokens, which is what lets
# scheduled campaigns send with no browser session. Generate with:
#   openssl rand -base64 32
# Falls back to NEXTAUTH_SECRET when unset — but then rotating NEXTAUTH_SECRET
# invalidates every stored grant and users must sign in again.
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=

# Optional: Upstash Redis (recommended for multi-instance rate limits / cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Billing (Razorpay — India)
NEXT_PUBLIC_APPWRITE_SUBSCRIPTIONS_COLLECTION_ID=subscriptions
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_PLAN_INSIGHTS_MONTHLY=
RAZORPAY_PLAN_INSIGHTS_ANNUAL=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
BILLING_ADMIN_EMAILS=adityamer.work@gmail.com